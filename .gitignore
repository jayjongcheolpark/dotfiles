# herdr runtime artifacts (regenerated at runtime; never commit)
home/.config/herdr/*.log
home/.config/herdr/session.json
home/.config/herdr/session.json.pre-restore.*
home/.config/herdr/*.sock
home/.config/herdr/plugins/github/
home/.config/herdr/plugins.json
home/.config/herdr/.plugins.lock

# macOS + nix build noise
.DS_Store
result
result-*

# Homebrew can leave unexpanded path placeholders under the cwd on error
\{\{pkgetc\}\}/
\{\{etc\}\}/

# Pi credentials, runtime caches, and Home Manager adoption backups stay local
/home/.pi/agent/auth.json
/home/.pi/agent/**/*.backup
/home/.pi/agent/models-store.json
/home/.pi/agent/provider-failover-state.json
/home/.pi/agent/provider-failover-debug.log

# Pi Calm is a runtime toggle; its local state file is never tracked
/home/.pi/agent/calm

# herdr writes this into Pi's extensions dir and overwrites it on update
/home/.pi/agent/extensions/herdr-agent-state.ts

# no-mistakes local validation state - never commit in this public repo
.no-mistakes/
